rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─── 1. ONBOARDING & ATLETAS (SOLO LECTURA) ───
    // La creación y edición ocurre solo en la App Móvil.
    // El Dashboard SaaS consume estos datos como 'Source of Truth'.
    match /athletes/{athleteId} {
      allow read, write: if true; 
      
      match /measurements/{measurementId} {
        allow read, write: if true;
      }
    }

    // ─── 2. ANÁLISIS DIARIO (LECTURA/ESCRITURA) ───
    // Colección maestra donde el Motor IVN y el Dashboard consolidan resultados.
    match /Daily_Performance/{docId} {
      allow read: if true;
      allow write: if true; 
    }
    
    // ─── 3. REGLA POR DEFECTO ───
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
