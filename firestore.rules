rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════════════════
    // IMED PREDICTOR — Firestore Security Rules v4.0
    // Producción + App Móvil Telemetría + Dashboard Realtime + Multi-Tenant
    // ══════════════════════════════════════════════════════════════════════════

    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return isAuthenticated() && ('role' in request.auth.token) ? request.auth.token.role : '';
    }

    function getTenantId() {
      return isAuthenticated() && ('tenantId' in request.auth.token) ? request.auth.token.tenantId : 'default';
    }

    function isSuperAdmin() {
      return getRole() == 'SUPER_ADMIN' || getRole() == 'ADMIN' || (isAuthenticated() && request.auth.token.email == 'ps.patriciorubilar@gmail.com');
    }

    function isPsicologo() {
      return isSuperAdmin() || getRole() == 'PSICOLOGO' || getRole() == 'COACH' || getRole() == 'DEMO';
    }

    function isNotBlocked() {
      return isAuthenticated() && (!('blocked' in request.auth.token) || request.auth.token.blocked != true);
    }

    function isValidDashboardUser() {
      return isAuthenticated() && isNotBlocked();
    }

    function belongsToTenant(tenantId) {
      return getTenantId() == tenantId;
    }

    // Helper para leer otro documento y verificar su tenant
    function getCol(col, id) {
      return get(/databases/$(database)/documents/$(col)/$(id)).data;
    }

    // ─── 1. ATLETAS Y TELEMETRÍA (App Móvil + Dashboard) ────────────────────
    match /athletes/{athleteId} {
      allow read: if isAuthenticated();
      
      // La app móvil escribe sin auth, y el dashboard escribe con auth de su propio tenant
      allow create, update: if !isAuthenticated() || isSuperAdmin() || belongsToTenant(request.resource.data.tenantId);
      // Eliminación permanente por el dueño del tenant o SuperAdmin
      allow delete: if isSuperAdmin() || belongsToTenant(resource.data.tenantId);

      match /measurements/{measurementId} {
        // Lectura de mediciones
        allow read: if isAuthenticated();
        // La app móvil escribe sin auth, clientes pueden limpiar mediciones al borrar atleta
        allow write: if true;
      }
    }

    // ─── 2. RENDIMIENTO DIARIO (Daily_Performance) ───────────────────────────
    match /Daily_Performance/{docId} {
      allow read: if isAuthenticated();
      // Escrito por Cloud Functions (Admin SDK bypasea esto) y por la app móvil
      allow create, update: if !isAuthenticated() || isSuperAdmin() || belongsToTenant(request.resource.data.tenantId);
      // Eliminación permanente por el dueño del tenant o SuperAdmin
      allow delete: if isSuperAdmin() || belongsToTenant(resource.data.tenantId);
    }

    // ─── 3. SUSCRIPCIONES Y TENANTS ──────────────────────────────────────────
    match /subscriptions/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    match /tenants/{tenantId} {
      // Cualquiera puede leer la info básica de un tenant (para validar códigos maestros en la app)
      allow read: if true;
      // Solo SuperAdmin o registro público de nuevo tenant (write por register_new_tenant corre en Cloud Functions con Admin SDK)
      allow write: if isSuperAdmin();
    }

    // ─── 4. AUDIT LOG & CLINICAL NOTES ───────────────────────────────────────
    match /audit_log/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Solo Admin SDK (Cloud Functions)
    }

    match /clinical_notes/{noteId} {
      // Aislamiento estricto por psicólogo creador y tenant
      allow read, update, delete: if isPsicologo()
                                  && isNotBlocked()
                                  && request.auth.uid == resource.data.psychologist_uid
                                  && belongsToTenant(resource.data.tenantId);
      allow create: if isPsicologo()
                    && isNotBlocked()
                    && request.auth.uid == request.resource.data.psychologist_uid
                    && belongsToTenant(request.resource.data.tenantId);
    }

    match /system_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ─── 5. REGLA GENERAL POR DEFECTO ────────────────────────────────────────
    match /{document=**} {
      allow read: if isValidDashboardUser() && isSuperAdmin();
      allow write: if false;
    }
  }
}
